{
  "name": "@kiwa-lab/cli",
  "version": "2.0.2",
  "description": "CLI for kiwa (init / doctor commands)",
  "license": "UNLICENSED",
  "author": {
    "name": "cardene",
    "url": "https://github.com/cardene777"
  },
  "keywords": [
    "kiwa",
    "cli",
    "scaffold"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cardene777/kiwa.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/cardene777/kiwa#readme",
  "bugs": {
    "url": "https://github.com/cardene777/kiwa/issues"
  },
  "type": "module",
  "bin": {
    "kiwa": "./dist/bin.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "README.ja.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup src/bin.ts src/index.ts --format esm --dts --onSuccess \"node scripts/copy-assets.mjs\"",
    "test": "vitest run tests --exclude '**/.vitest-dist/**' --exclude 'tests/perf/**' --exclude '**/.stryker-tmp/**' --environment node --no-file-parallelism --testTimeout 30000",
    "test:fast": "vitest run tests --changed ${KIWA_FAST_BASE:-main} --exclude '**/.vitest-dist/**' --exclude 'tests/perf/**' --exclude '**/.stryker-tmp/**' --environment node --no-file-parallelism --testTimeout 30000",
    "pretest:perf": "pnpm -F @kiwa-lab/perf-harness build",
    "test:perf": "vitest run -c vitest.perf.config.ts --reporter=verbose",
    "test:cov": "node -e \"require('node:fs').rmSync('.vitest-dist',{recursive:true,force:true})\" && tsc -p tsconfig.vitest.json && vitest run .vitest-dist/tests --exclude '**/.stryker-tmp/**' --environment node --no-file-parallelism --testTimeout 30000 --coverage --coverage.provider=v8 --coverage.reporter=json --coverage.reporter=json-summary --coverage.reporter=text --coverage.reportsDirectory=coverage --coverage.include='.vitest-dist/src/**/*.js' --coverage.exclude='.vitest-dist/tests/**' --coverage.exclude='.vitest-dist/src/bin.js' && node ../../scripts/record-artifact-inputs.mjs coverage",
    "test:mutation": "node ../../scripts/package-mutation.mjs",
    "test:a11y": "node ../../scripts/run-axe-baseline.mjs",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "node ../../scripts/assert-pnpm-publish.mjs"
  },
  "devDependencies": {
    "@kiwa-lab/perf-harness": "workspace:*",
    "@kiwa-lab/skill-test": "workspace:*",
    "@stryker-mutator/core": "^8.7.1",
    "@stryker-mutator/vitest-runner": "^8.7.1",
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^3.2.6",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^3.2.6"
  }
}
