{
  "name": "@kiwa-test/auth",
  "version": "0.2.0-0",
  "description": "Auth test adapter for kiwa (NextAuth v5 / Auth.js + Lucia v3 + Better Auth + Clerk + Auth0 — session + provider + DB adapter mocks)",
  "license": "MIT",
  "author": {
    "name": "cardene",
    "url": "https://github.com/cardene777"
  },
  "keywords": [
    "kiwa",
    "auth",
    "nextauth",
    "auth.js",
    "lucia",
    "lucia-auth",
    "better-auth",
    "clerk",
    "auth0",
    "jwt",
    "organizations",
    "multi-tenant",
    "magic-link",
    "totp",
    "2fa",
    "passkey",
    "testing",
    "vitest",
    "prisma",
    "drizzle",
    "kysely",
    "sqlite",
    "postgresql"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cardene777/kiwa.git",
    "directory": "packages/auth"
  },
  "homepage": "https://github.com/cardene777/kiwa#readme",
  "bugs": {
    "url": "https://github.com/cardene777/kiwa/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "test": "node -e \"require('node:fs').rmSync('.vitest-dist',{recursive:true,force:true})\" && tsc -p tsconfig.vitest.json && vitest run .vitest-dist/tests --environment node",
    "test:cov": "node -e \"require('node:fs').rmSync('.vitest-dist',{recursive:true,force:true})\" && tsc -p tsconfig.vitest.json && vitest run .vitest-dist/tests --environment node --coverage --coverage.provider=v8 --coverage.reporter=json --coverage.reporter=json-summary --coverage.reporter=text --coverage.reportsDirectory=coverage --coverage.include='.vitest-dist/src/**/*.js' --coverage.exclude='.vitest-dist/tests/**'",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@kiwa-test/core": "workspace:*"
  },
  "peerDependencies": {
    "next-auth": ">=5.0.0-beta.0 <6",
    "lucia": "^3",
    "better-auth": ">=1.0.0-beta.0",
    "@clerk/backend": ">=1.0.0",
    "auth0": ">=4.0.0",
    "vitest": "^2"
  },
  "peerDependenciesMeta": {
    "next-auth": {
      "optional": true
    },
    "lucia": {
      "optional": true
    },
    "better-auth": {
      "optional": true
    },
    "@clerk/backend": {
      "optional": true
    },
    "auth0": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^2.1.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
