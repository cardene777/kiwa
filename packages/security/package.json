{
  "name": "@kiwa-lab/security",
  "version": "2.0.0",
  "description": "Security test harness for kiwa — v0.1 8 base axis (CSP + Rate limit + Authorization + WAF + Threat model + Secrets scanning + SBOM + Security headers) unified across 4 providers (helmet + express-rate-limit + casbin + coraza), plus v0.2 advanced II 8 axis (mTLS + Zero-trust + SIEM audit + Incident response + Cryptography advanced + Container/K8s + Supply chain + Web Vitals security) unified across 4 providers (istio + opa + siem-splunk + vault) with two 4 provider × 8 axis fidelity grids (32 + 32 = 64 combination coverage), real driver env-gate (KIWA_MODE=real + testcontainers), and quality-metrics 11-axis integration.",
  "license": "UNLICENSED",
  "author": {
    "name": "cardene",
    "url": "https://github.com/cardene777"
  },
  "keywords": [
    "kiwa",
    "security",
    "csp",
    "content-security-policy",
    "nonce",
    "trusted-types",
    "rate-limit",
    "token-bucket",
    "leaky-bucket",
    "sliding-window",
    "authorization",
    "rbac",
    "abac",
    "casbin",
    "waf",
    "coraza",
    "owasp-crs",
    "threat-model",
    "stride",
    "pasta",
    "dread",
    "secrets-scanning",
    "trufflehog",
    "gitleaks",
    "sbom",
    "cyclonedx",
    "spdx",
    "osv",
    "nvd",
    "security-headers",
    "hsts",
    "permissions-policy",
    "helmet",
    "mtls",
    "certificate-pinning",
    "ocsp-stapling",
    "certificate-transparency",
    "zero-trust",
    "device-posture",
    "jit-access",
    "micro-segmentation",
    "siem",
    "audit-log",
    "tamper-evident",
    "incident-response",
    "playbook",
    "forensics",
    "post-mortem",
    "aead",
    "kdf",
    "envelope-encryption",
    "key-rotation",
    "hsm",
    "post-quantum",
    "ml-kem",
    "kubernetes",
    "pod-security",
    "network-policy",
    "admission-controller",
    "opa",
    "gatekeeper",
    "kyverno",
    "slsa",
    "reproducible-build",
    "signed-provenance",
    "attestation",
    "sigstore",
    "in-toto",
    "sri",
    "trusted-types",
    "cross-origin-isolation",
    "coop",
    "coep",
    "istio",
    "splunk",
    "vault",
    "mock",
    "fidelity",
    "testing"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cardene777/kiwa.git",
    "directory": "packages/security"
  },
  "homepage": "https://github.com/cardene777/kiwa#readme",
  "bugs": {
    "url": "https://github.com/cardene777/kiwa/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup || node -e \"const{rmSync}=require('node:fs');for(const f of ['dist/index.d.ts','dist/index.d.cts'])rmSync(f,{force:true});process.exit(1)\"",
    "test": "node -e \"require('node:fs').rmSync('.vitest-dist',{recursive:true,force:true})\" && tsc -p tsconfig.vitest.json && vitest run .vitest-dist/tests --exclude '**/.stryker-tmp/**' --environment node",
    "test:cov": "node -e \"require('node:fs').rmSync('.vitest-dist',{recursive:true,force:true})\" && tsc -p tsconfig.vitest.json && vitest run .vitest-dist/tests --exclude '**/.stryker-tmp/**' --environment node --coverage --coverage.provider=v8 --coverage.reporter=json --coverage.reporter=json-summary --coverage.reporter=text --coverage.reportsDirectory=coverage --coverage.include='.vitest-dist/src/**/*.js' --coverage.exclude='.vitest-dist/tests/**' && node ../../scripts/record-artifact-inputs.mjs coverage",
    "test:perf": "vitest run -c vitest.perf.config.ts --reporter=verbose",
    "test:mutation": "node ../../scripts/package-mutation.mjs",
    "test:a11y": "node ../../scripts/run-axe-baseline.mjs",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "node ../../scripts/assert-pnpm-publish.mjs"
  },
  "dependencies": {
    "@kiwa-lab/core": "workspace:*",
    "@kiwa-lab/quality-metrics": "workspace:*"
  },
  "devDependencies": {
    "@kiwa-lab/perf-harness": "workspace:*",
    "@stryker-mutator/core": "^8.7.1",
    "@stryker-mutator/vitest-runner": "^8.7.1",
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^3.2.6",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^3.2.6",
    "@kiwa-lab/skill-test": "workspace:*"
  }
}
