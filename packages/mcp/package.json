{
  "name": "@kiwa-test/mcp",
  "version": "0.2.0",
  "description": "Model Context Protocol (MCP) server mock harness for kiwa — JSON-RPC 2.0 handshake + tool registration + schema validation + client-server roundtrip against a stable in-process transport. Ships with 5 fixture tools (echo / calc / weather / search / db-query) so kiwa tests can exercise the exact MCP tool call chain a real MCP server implements.",
  "license": "MIT",
  "author": {
    "name": "cardene",
    "url": "https://github.com/cardene777"
  },
  "keywords": [
    "kiwa",
    "mcp",
    "model-context-protocol",
    "anthropic",
    "json-rpc",
    "json-rpc-2.0",
    "tool-use",
    "tools",
    "server",
    "client",
    "handshake",
    "mock",
    "testing"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cardene777/kiwa.git",
    "directory": "packages/mcp"
  },
  "homepage": "https://github.com/cardene777/kiwa#readme",
  "bugs": {
    "url": "https://github.com/cardene777/kiwa/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "test": "node -e \"require('node:fs').rmSync('.vitest-dist',{recursive:true,force:true})\" && tsc -p tsconfig.vitest.json && vitest run .vitest-dist/tests --environment node",
    "pretest:perf": "pnpm -F @kiwa-test/perf-harness build",
    "test:perf": "vitest run -c vitest.perf.config.ts --reporter=verbose",
    "test:mutation": "stryker run",
    "test:a11y": "node ../../scripts/run-axe-baseline.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@kiwa-test/core": "workspace:*",
    "@kiwa-test/quality-metrics": "workspace:*"
  },
  "devDependencies": {
    "@kiwa-test/perf-harness": "workspace:*",
    "@stryker-mutator/core": "^8.7.1",
    "@stryker-mutator/vitest-runner": "^8.7.1",
    "@types/node": "^22.10.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
