{
  "name": "@kiwa/queue",
  "version": "0.3.0-1",
  "description": "Queue test adapter for kiwa — BullMQ (Redis-backed) sandbox (in-memory) + testcontainers Redis env + Inngest (event-driven) dev-server + stub env + Cloudflare Queues (miniflare + wrangler) env + AWS SQS (stub + localstack) env + RabbitMQ basic + advanced (DLX + delayed message + cluster + federation + auto-reconnect) env, with job / run / message assertion helpers",
  "license": "MIT",
  "author": {
    "name": "cardene",
    "url": "https://github.com/cardene777"
  },
  "keywords": [
    "kiwa",
    "queue",
    "bullmq",
    "redis",
    "testcontainers",
    "sandbox",
    "job",
    "worker",
    "inngest",
    "event-driven",
    "dev-server",
    "cloudflare-queues",
    "miniflare",
    "wrangler",
    "edge",
    "sqs",
    "aws-sqs",
    "localstack",
    "fifo",
    "rabbitmq",
    "amqp",
    "amqplib",
    "amqp-0-9-1",
    "dlx",
    "dead-letter-exchange",
    "delayed-message",
    "quorum-queue",
    "cluster",
    "federation",
    "amqp-connection-manager",
    "testing",
    "vitest"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cardene777/kiwa.git",
    "directory": "packages/queue"
  },
  "homepage": "https://github.com/cardene777/kiwa#readme",
  "bugs": {
    "url": "https://github.com/cardene777/kiwa/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "test": "node -e \"require('node:fs').rmSync('.vitest-dist',{recursive:true,force:true})\" && tsc -p tsconfig.vitest.json && vitest run .vitest-dist/tests --environment node",
    "pretest:perf": "pnpm -F @kiwa/perf-harness build",
    "test:perf": "vitest run -c vitest.perf.config.ts --reporter=verbose",
    "test:cov": "node -e \"require('node:fs').rmSync('.vitest-dist',{recursive:true,force:true})\" && tsc -p tsconfig.vitest.json && vitest run .vitest-dist/tests --environment node --coverage --coverage.provider=v8 --coverage.reporter=json --coverage.reporter=json-summary --coverage.reporter=text --coverage.reportsDirectory=coverage --coverage.include='.vitest-dist/src/**/*.js' --coverage.exclude='.vitest-dist/tests/**'",
    "test:mutation": "stryker run",
    "test:a11y": "node ../../scripts/run-axe-baseline.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@kiwa/core": "workspace:*"
  },
  "peerDependencies": {
    "bullmq": "^5",
    "inngest": "^3",
    "ioredis": "^5",
    "miniflare": ">=3",
    "testcontainers": ">=10",
    "vitest": "^2",
    "wrangler": ">=3"
  },
  "peerDependenciesMeta": {
    "bullmq": {
      "optional": true
    },
    "inngest": {
      "optional": true
    },
    "ioredis": {
      "optional": true
    },
    "miniflare": {
      "optional": true
    },
    "testcontainers": {
      "optional": true
    },
    "wrangler": {
      "optional": true
    }
  },
  "devDependencies": {
    "@kiwa/perf-harness": "workspace:*",
    "@stryker-mutator/core": "^8.7.1",
    "@stryker-mutator/vitest-runner": "^8.7.1",
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^2.1.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
