{
  "name": "@kiwa-lab/orm",
  "version": "2.1.0",
  "description": "ORM query test adapter for kiwa — setup Drizzle, Prisma, or Kysely environments against in-memory SQLite (mock) or testcontainers Postgres/MySQL (live), apply SQL string / SQL string[] / drizzle-kit-generated `{ folder }` migrations, seed fixtures, and assert query results with a consistent setupOrmEnv API",
  "license": "UNLICENSED",
  "author": {
    "name": "cardene",
    "url": "https://github.com/cardene777"
  },
  "keywords": [
    "kiwa",
    "orm",
    "drizzle",
    "prisma",
    "kysely",
    "sqlite",
    "postgres",
    "mysql",
    "testcontainers",
    "query",
    "database",
    "testing"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cardene777/kiwa.git",
    "directory": "packages/orm"
  },
  "homepage": "https://github.com/cardene777/kiwa#readme",
  "bugs": {
    "url": "https://github.com/cardene777/kiwa/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "test": "node -e \"require('node:fs').rmSync('.vitest-dist',{recursive:true,force:true})\" && tsc -p tsconfig.vitest.json && vitest run .vitest-dist/tests --environment node",
    "pretest:perf": "pnpm -F @kiwa-lab/perf-harness build",
    "test:perf": "vitest run -c vitest.perf.config.ts --reporter=verbose",
    "test:cov": "node -e \"require('node:fs').rmSync('.vitest-dist',{recursive:true,force:true})\" && tsc -p tsconfig.vitest.json && vitest run .vitest-dist/tests --environment node --coverage --coverage.provider=v8 --coverage.reporter=json --coverage.reporter=json-summary --coverage.reporter=text --coverage.reportsDirectory=coverage --coverage.include='.vitest-dist/src/**/*.js' --coverage.exclude='.vitest-dist/tests/**' --coverage.exclude='**/*.d.ts'",
    "test:mutation": "stryker run",
    "test:a11y": "node ../../scripts/run-axe-baseline.mjs",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "node ../../scripts/assert-pnpm-publish.mjs"
  },
  "dependencies": {
    "@kiwa-lab/core": "workspace:*"
  },
  "peerDependencies": {
    "@prisma/client": ">=5",
    "@testcontainers/mysql": ">=10",
    "@testcontainers/postgresql": ">=10",
    "better-sqlite3": ">=11",
    "drizzle-orm": ">=0.36",
    "kysely": ">=0.27",
    "mysql2": ">=3.11",
    "pg": ">=8",
    "postgres": ">=3.4",
    "prisma": ">=5",
    "testcontainers": ">=10",
    "vitest": "^2"
  },
  "peerDependenciesMeta": {
    "@prisma/client": {
      "optional": true
    },
    "@testcontainers/mysql": {
      "optional": true
    },
    "@testcontainers/postgresql": {
      "optional": true
    },
    "better-sqlite3": {
      "optional": true
    },
    "drizzle-orm": {
      "optional": true
    },
    "kysely": {
      "optional": true
    },
    "mysql2": {
      "optional": true
    },
    "pg": {
      "optional": true
    },
    "postgres": {
      "optional": true
    },
    "prisma": {
      "optional": true
    },
    "testcontainers": {
      "optional": true
    }
  },
  "devDependencies": {
    "@kiwa-lab/perf-harness": "workspace:*",
    "@kiwa-lab/quality-metrics": "workspace:*",
    "@prisma/client": "^5.22.0",
    "@stryker-mutator/core": "^8.7.1",
    "@stryker-mutator/vitest-runner": "^8.7.1",
    "@testcontainers/mysql": "^10.16.0",
    "@testcontainers/postgresql": "^10.16.0",
    "@types/better-sqlite3": "^7.6.0",
    "@types/dockerode": "^3.3.0",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.0",
    "@vitest/coverage-v8": "^2.1.0",
    "better-sqlite3": "^11.7.0",
    "dockerode": "^4.0.0",
    "drizzle-orm": "^0.36.0",
    "kysely": "^0.27.0",
    "mysql2": "^3.11.0",
    "pg": "^8.13.0",
    "postgres": "^3.4.0",
    "prisma": "^5.22.0",
    "testcontainers": "^10.16.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "@kiwa-lab/skill-test": "workspace:*"
  }
}
