{
  "name": "@kiwa-test/ui",
  "version": "0.4.1",
  "description": "React component test adapter for kiwa (Vitest + Testing Library + JSDOM)",
  "license": "MIT",
  "author": {
    "name": "cardene",
    "url": "https://github.com/cardene777"
  },
  "keywords": [
    "kiwa",
    "ui",
    "react",
    "vue",
    "svelte",
    "solid",
    "lit",
    "qwik",
    "angular",
    "web-components",
    "testing",
    "vitest",
    "testing-library",
    "jsdom"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cardene777/kiwa.git",
    "directory": "packages/ui"
  },
  "homepage": "https://github.com/cardene777/kiwa#readme",
  "bugs": {
    "url": "https://github.com/cardene777/kiwa/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "test": "node -e \"require('node:fs').rmSync('.vitest-dist',{recursive:true,force:true})\" && tsc -p tsconfig.vitest.json && vitest run .vitest-dist/tests/setup-component-env.test.js .vitest-dist/tests/vue.test.js .vitest-dist/tests/solid.test.js .vitest-dist/tests/lit.test.js .vitest-dist/tests/qwik.test.js .vitest-dist/tests/angular.test.js --environment jsdom && vitest run .vitest-dist/tests/browser.test.js --environment node --testTimeout 30000",
    "test:cov": "node -e \"require('node:fs').rmSync('.vitest-dist',{recursive:true,force:true})\" && tsc -p tsconfig.vitest.json && vitest run .vitest-dist/tests/setup-component-env.test.js .vitest-dist/tests/vue.test.js --environment jsdom --coverage --coverage.provider=v8 --coverage.reporter=json --coverage.reporter=json-summary --coverage.reporter=text --coverage.reportsDirectory=coverage --coverage.include='.vitest-dist/src/setup-component-env.js' --coverage.include='.vitest-dist/src/vue.js' --coverage.include='.vitest-dist/src/index.js' --coverage.exclude='.vitest-dist/tests/**'",
    "test:mutation": "stryker run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@kiwa-test/spec": "workspace:*"
  },
  "peerDependencies": {
    "@angular/core": "^17 || ^18 || ^19",
    "@angular/platform-browser-dynamic": "^17 || ^18 || ^19",
    "@builder.io/qwik": "^1.12",
    "@noma.to/qwik-testing-library": "^1.6",
    "@open-wc/testing-helpers": "^3",
    "@playwright/test": "^1.49.0",
    "@solidjs/testing-library": "^0.8",
    "@testing-library/angular": "^17 || ^18 || ^19",
    "@testing-library/react": "^16",
    "@testing-library/svelte": "^5",
    "@testing-library/user-event": "^14",
    "@vue/test-utils": "^2",
    "jsdom": "^25",
    "lit": "^3",
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19",
    "solid-js": "^1.9",
    "svelte": "^4 || ^5",
    "vitest": "^2",
    "vue": "^3",
    "zone.js": "^0.14 || ^0.15"
  },
  "peerDependenciesMeta": {
    "@angular/core": {
      "optional": true
    },
    "@angular/platform-browser-dynamic": {
      "optional": true
    },
    "@builder.io/qwik": {
      "optional": true
    },
    "@noma.to/qwik-testing-library": {
      "optional": true
    },
    "@open-wc/testing-helpers": {
      "optional": true
    },
    "@playwright/test": {
      "optional": true
    },
    "@solidjs/testing-library": {
      "optional": true
    },
    "@testing-library/angular": {
      "optional": true
    },
    "@testing-library/react": {
      "optional": true
    },
    "@testing-library/svelte": {
      "optional": true
    },
    "@testing-library/user-event": {
      "optional": true
    },
    "@vue/test-utils": {
      "optional": true
    },
    "jsdom": {
      "optional": true
    },
    "lit": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    },
    "svelte": {
      "optional": true
    },
    "vue": {
      "optional": true
    },
    "zone.js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@open-wc/testing-helpers": "^3.0.1",
    "@playwright/test": "^1.49.0",
    "@solidjs/testing-library": "^0.8.10",
    "@stryker-mutator/core": "^8.7.1",
    "@stryker-mutator/vitest-runner": "^8.7.1",
    "@testing-library/react": "^16.1.0",
    "@testing-library/svelte": "^5.2.4",
    "@vitest/coverage-v8": "^2.1.0",
    "@vue/test-utils": "^2.4.6",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "jsdom": "^25.0.1",
    "lit": "^3.3.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "solid-js": "^1.9.7",
    "svelte": "^4.2.19",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "vue": "^3.5.13"
  }
}
