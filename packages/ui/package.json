{
  "name": "@kiwa-test/ui",
  "version": "0.2.0",
  "description": "React component test adapter for kiwa (Vitest + Testing Library + JSDOM)",
  "license": "MIT",
  "author": {
    "name": "cardene",
    "url": "https://github.com/cardene777"
  },
  "keywords": [
    "kiwa",
    "ui",
    "react",
    "testing",
    "vitest",
    "testing-library",
    "jsdom"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cardene777/kiwa.git",
    "directory": "packages/ui"
  },
  "homepage": "https://github.com/cardene777/kiwa#readme",
  "bugs": {
    "url": "https://github.com/cardene777/kiwa/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "test": "node -e \"require('node:fs').rmSync('.vitest-dist',{recursive:true,force:true})\" && tsc -p tsconfig.vitest.json && vitest run .vitest-dist/tests/setup-component-env.test.js --environment jsdom && vitest run .vitest-dist/tests/browser.test.js --environment node --testTimeout 30000",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@kiwa-test/spec": "workspace:*"
  },
  "peerDependencies": {
    "@playwright/test": "^1.49.0",
    "@testing-library/react": "^16",
    "@testing-library/user-event": "^14",
    "jsdom": "^25",
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19",
    "vitest": "^2"
  },
  "peerDependenciesMeta": {
    "@playwright/test": {
      "optional": true
    },
    "@testing-library/react": {
      "optional": true
    },
    "@testing-library/user-event": {
      "optional": true
    },
    "jsdom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "jsdom": "^25.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
