{
  "name": "kiwa-monorepo",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm -F @kiwa-test/core -F @kiwa-test/dapp -F @kiwa-test/api -F @kiwa-test/ui -F @kiwa-test/data -F @kiwa-test/cli-test -F @kiwa-test/observability -F @kiwa-test/e2e -F @kiwa-test/cli -F @kiwa-test/a11y -F @kiwa-test/visual -F @kiwa-test/nextjs -F @kiwa-test/nuxt -F @kiwa-test/sveltekit -F @kiwa-test/remix -F @kiwa-test/astro -F @kiwa-test/solidstart -F @kiwa-test/qwikcity -F @kiwa-test/edge -F @kiwa-test/orm -F @kiwa-test/auth -F @kiwa-test/payment -F @kiwa-test/queue -F @kiwa-test/cache -F @kiwa-test/solidjs -F @kiwa-test/fresh -F @kiwa-test/hono -F @kiwa-test/perf-harness -F @kiwa-test/quality-metrics -F @kiwa-test/realtime -F @kiwa-test/release-invariants -F @kiwa-test/agent -F @kiwa-test/ai-llm -F @kiwa-test/component -F @kiwa-test/mcp -F @kiwa-test/search -F @kiwa-test/security -F @kiwa-test/security-devsecops -F @kiwa-test/streaming -F @kiwa-test/mobile -F @kiwa-test/desktop build && pnpm publish --filter @kiwa-test/core --filter @kiwa-test/dapp --filter @kiwa-test/api --filter @kiwa-test/ui --filter @kiwa-test/data --filter @kiwa-test/cli-test --filter @kiwa-test/observability --filter @kiwa-test/e2e --filter @kiwa-test/cli --filter @kiwa-test/a11y --filter @kiwa-test/visual --filter @kiwa-test/nextjs --filter @kiwa-test/nuxt --filter @kiwa-test/sveltekit --filter @kiwa-test/remix --filter @kiwa-test/astro --filter @kiwa-test/solidstart --filter @kiwa-test/qwikcity --filter @kiwa-test/edge --filter @kiwa-test/orm --filter @kiwa-test/auth --filter @kiwa-test/payment --filter @kiwa-test/queue --filter @kiwa-test/cache --filter @kiwa-test/solidjs --filter @kiwa-test/fresh --filter @kiwa-test/hono --filter @kiwa-test/perf-harness --filter @kiwa-test/quality-metrics --filter @kiwa-test/realtime --filter @kiwa-test/release-invariants --filter @kiwa-test/agent --filter @kiwa-test/ai-llm --filter @kiwa-test/component --filter @kiwa-test/mcp --filter @kiwa-test/search --filter @kiwa-test/security --filter @kiwa-test/security-devsecops --filter @kiwa-test/streaming --filter @kiwa-test/mobile --filter @kiwa-test/desktop --access public --no-git-checks",
    "test": "pnpm -r test",
    "test:perf": "pnpm -r --filter='./packages/perf-harness' test && pnpm -r --parallel --if-present run test:perf",
    "test:mutation": "pnpm -F @kiwa-test/core -F @kiwa-test/api -F @kiwa-test/ui -F @kiwa-test/data -F @kiwa-test/cli-test -F @kiwa-test/observability -F @kiwa-test/e2e -F @kiwa-test/cli -F @kiwa-test/dapp -F @kiwa-test/a11y -F @kiwa-test/visual -F @kiwa-test/nextjs -F @kiwa-test/nuxt -F @kiwa-test/sveltekit -F @kiwa-test/remix -F @kiwa-test/astro -F @kiwa-test/solidstart -F @kiwa-test/qwikcity -F @kiwa-test/edge -F @kiwa-test/solidjs -F @kiwa-test/fresh -F @kiwa-test/hono -F @kiwa-test/auth -F @kiwa-test/payment -F @kiwa-test/queue -F @kiwa-test/cache -F @kiwa-test/streaming -F @kiwa-test/ai-llm -F @kiwa-test/realtime -F @kiwa-test/mcp -F @kiwa-test/agent -F @kiwa-test/component -F @kiwa-test/search -F @kiwa-test/orm --no-bail run test:mutation",
    "test:a11y": "pnpm -F @kiwa-test/core -F @kiwa-test/api -F @kiwa-test/ui -F @kiwa-test/data -F @kiwa-test/cli-test -F @kiwa-test/observability -F @kiwa-test/e2e -F @kiwa-test/cli -F @kiwa-test/dapp -F @kiwa-test/a11y -F @kiwa-test/visual -F @kiwa-test/nextjs -F @kiwa-test/nuxt -F @kiwa-test/sveltekit -F @kiwa-test/remix -F @kiwa-test/astro -F @kiwa-test/solidstart -F @kiwa-test/qwikcity -F @kiwa-test/edge -F @kiwa-test/solidjs -F @kiwa-test/fresh -F @kiwa-test/hono -F @kiwa-test/auth -F @kiwa-test/payment -F @kiwa-test/queue -F @kiwa-test/cache -F @kiwa-test/streaming -F @kiwa-test/ai-llm -F @kiwa-test/realtime -F @kiwa-test/mcp -F @kiwa-test/agent -F @kiwa-test/component -F @kiwa-test/search -F @kiwa-test/orm -F @kiwa-test/perf-harness -F @kiwa-test/quality-metrics -F @kiwa-test/release-invariants --no-bail run test:a11y",
    "gate:coverage": "node scripts/check-coverage-gates.mjs",
    "gate:mutation": "node scripts/check-mutation-gates.mjs",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "test:docs-e2e": "playwright test tests/docs-site-e2e"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.10",
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.10.0",
    "typescript": "^5.6.0",
    "vitepress": "^1.6.4",
    "vitest": "^2.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ]
  }
}
