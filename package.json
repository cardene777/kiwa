    "gate:coverage": "node scripts/check-coverage-gates.mjs",
    "gate:mutation": "node scripts/check-mutation-gates.mjs",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "test:docs-e2e": "playwright test tests/docs-site-e2e",
    "test:all": "node scripts/test-all.mjs",
    "typecheck:all": "node scripts/typecheck-all.mjs",
    "typecheck:coverage": "node scripts/typecheck-coverage.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.10",
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.10.0",
