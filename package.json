{
  "name": "kiwa-monorepo",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm -F @kiwa/core -F @kiwa/dapp -F @kiwa/api -F @kiwa/ui -F @kiwa/data -F @kiwa/cli-test -F @kiwa/observability -F @kiwa/e2e -F @kiwa/cli -F @kiwa/a11y -F @kiwa/visual -F @kiwa/nextjs -F @kiwa/nuxt -F @kiwa/sveltekit -F @kiwa/remix -F @kiwa/astro -F @kiwa/solidstart -F @kiwa/qwikcity -F @kiwa/edge -F @kiwa/orm -F @kiwa/auth -F @kiwa/payment -F @kiwa/queue -F @kiwa/cache -F @kiwa/solidjs -F @kiwa/fresh -F @kiwa/hono -F @kiwa/perf-harness -F @kiwa/quality-metrics -F @kiwa/realtime -F @kiwa/release-invariants -F @kiwa/agent -F @kiwa/ai-llm -F @kiwa/component -F @kiwa/mcp -F @kiwa/search -F @kiwa/security -F @kiwa/security-devsecops -F @kiwa/streaming -F @kiwa/mobile -F @kiwa/desktop build && pnpm publish --filter @kiwa/core --filter @kiwa/dapp --filter @kiwa/api --filter @kiwa/ui --filter @kiwa/data --filter @kiwa/cli-test --filter @kiwa/observability --filter @kiwa/e2e --filter @kiwa/cli --filter @kiwa/a11y --filter @kiwa/visual --filter @kiwa/nextjs --filter @kiwa/nuxt --filter @kiwa/sveltekit --filter @kiwa/remix --filter @kiwa/astro --filter @kiwa/solidstart --filter @kiwa/qwikcity --filter @kiwa/edge --filter @kiwa/orm --filter @kiwa/auth --filter @kiwa/payment --filter @kiwa/queue --filter @kiwa/cache --filter @kiwa/solidjs --filter @kiwa/fresh --filter @kiwa/hono --filter @kiwa/perf-harness --filter @kiwa/quality-metrics --filter @kiwa/realtime --filter @kiwa/release-invariants --filter @kiwa/agent --filter @kiwa/ai-llm --filter @kiwa/component --filter @kiwa/mcp --filter @kiwa/search --filter @kiwa/security --filter @kiwa/security-devsecops --filter @kiwa/streaming --filter @kiwa/mobile --filter @kiwa/desktop --access public --no-git-checks",
    "test": "pnpm -r test",
    "test:perf": "pnpm -r --filter='./packages/perf-harness' test && pnpm -r --parallel --if-present run test:perf",
    "test:mutation": "pnpm -F @kiwa/core -F @kiwa/api -F @kiwa/ui -F @kiwa/data -F @kiwa/cli-test -F @kiwa/observability -F @kiwa/e2e -F @kiwa/cli -F @kiwa/dapp -F @kiwa/a11y -F @kiwa/visual -F @kiwa/nextjs -F @kiwa/nuxt -F @kiwa/sveltekit -F @kiwa/remix -F @kiwa/astro -F @kiwa/solidstart -F @kiwa/qwikcity -F @kiwa/edge -F @kiwa/solidjs -F @kiwa/fresh -F @kiwa/hono -F @kiwa/auth -F @kiwa/payment -F @kiwa/queue -F @kiwa/cache -F @kiwa/streaming -F @kiwa/ai-llm -F @kiwa/realtime -F @kiwa/mcp -F @kiwa/agent -F @kiwa/component -F @kiwa/search -F @kiwa/orm --no-bail run test:mutation",
    "test:a11y": "pnpm -F @kiwa/core -F @kiwa/api -F @kiwa/ui -F @kiwa/data -F @kiwa/cli-test -F @kiwa/observability -F @kiwa/e2e -F @kiwa/cli -F @kiwa/dapp -F @kiwa/a11y -F @kiwa/visual -F @kiwa/nextjs -F @kiwa/nuxt -F @kiwa/sveltekit -F @kiwa/remix -F @kiwa/astro -F @kiwa/solidstart -F @kiwa/qwikcity -F @kiwa/edge -F @kiwa/solidjs -F @kiwa/fresh -F @kiwa/hono -F @kiwa/auth -F @kiwa/payment -F @kiwa/queue -F @kiwa/cache -F @kiwa/streaming -F @kiwa/ai-llm -F @kiwa/realtime -F @kiwa/mcp -F @kiwa/agent -F @kiwa/component -F @kiwa/search -F @kiwa/orm -F @kiwa/perf-harness -F @kiwa/quality-metrics -F @kiwa/release-invariants --no-bail run test:a11y",
    "gate:coverage": "node scripts/check-coverage-gates.mjs",
    "gate:mutation": "node scripts/check-mutation-gates.mjs",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "test:docs-e2e": "playwright test tests/docs-site-e2e"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.10",
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.10.0",
    "typescript": "^5.6.0",
    "vitepress": "^1.6.4",
    "vitest": "^2.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ]
  }
}
