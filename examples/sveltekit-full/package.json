{
  "name": "examples-sveltekit-full",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node ../../scripts/build-deps.mjs @kiwa-lab/sveltekit @kiwa-lab/core",
    "dev": "vite dev",
    "prepare": "svelte-kit sync",
    "test": "pnpm build && node -e \"require('node:fs').rmSync('.vitest-dist',{recursive:true,force:true})\" && tsc -p tsconfig.vitest.json && vitest run .vitest-dist/tests --environment node",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.e2e.json"
  },
  "dependencies": {
    "@kiwa-lab/core": "workspace:*",
    "@kiwa-lab/sveltekit": "workspace:*"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@sveltejs/adapter-auto": "^3.3.0",
    "@sveltejs/kit": "^2.8.0",
    "@sveltejs/vite-plugin-svelte": "^4.0.0",
    "@types/node": "^22.10.0",
    "svelte": "^5.1.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^3.2.6"
  }
}
