{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": ".vitest-dist",
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["node", "vitest"],
    "noEmit": false,
    "noUncheckedIndexedAccess": false
  },
  "include": [
    "src/lib/_kiwa/**/*.ts",
    "src/utils/_kiwa/**/*.ts",
    "src/pages/api/_kiwa/**/*.ts",
    "tests/**/*.ts"
  ],
  "exclude": ["node_modules", "dist", ".vitest-dist", ".astro", "tests/e2e/**", "playwright.config.ts"]
}
