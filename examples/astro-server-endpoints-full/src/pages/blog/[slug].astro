---
// blog/[slug].astro — View Transitions の遷移先 page。
// transition:name で site-header を継承し、 article 本文だけ swap される。
import { ViewTransitions } from 'astro:transitions';
const { slug } = Astro.params;
const titles: Record<string, string> = {
  '2026-06-30': 'kiwa v1.3 milestone start',
  '2026-06-15': 'Astro v5 view transitions overview',
};
const title = titles[slug ?? ''] ?? slug ?? 'unknown post';
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>{title} — kiwa blog</title>
    <ViewTransitions />
  </head>
  <body>
    <header transition:name="site-header">
      <h1>kiwa blog (View Transitions PoC)</h1>
    </header>
    <main>
      <article data-kiwa-post-slug={slug}>
        <h2>{title}</h2>
        <p>slug: <code>{slug}</code></p>
        <p><a href="/blog/" data-kiwa-link="back">back to list</a></p>
      </article>
    </main>
    <script>
      function appendTrace(eventName: string) {
        const prior = document.body.dataset.kiwaVtTrace ?? '';
        document.body.dataset.kiwaVtTrace = prior ? `${prior}|${eventName}` : eventName;
      }
      document.addEventListener('astro:before-preparation', () => appendTrace('before-preparation'));
      document.addEventListener('astro:after-preparation', () => appendTrace('after-preparation'));
      document.addEventListener('astro:before-swap', () => appendTrace('before-swap'));
      document.addEventListener('astro:after-swap', () => appendTrace('after-swap'));
    </script>
  </body>
</html>
