---
// login.astro — test fixture 用 login page。 POST で session cookie を set し from に redirect。

if (Astro.request.method === 'POST') {
  const formData = await Astro.request.formData();
  const session = (formData.get('session') ?? 'guest').toString();
  const url = new URL(Astro.request.url);
  const from = url.searchParams.get('from') ?? '/';
  Astro.cookies.set('session', session, { path: '/' });
  return Astro.redirect(from, 303);
}

const url = new URL(Astro.request.url);
const from = url.searchParams.get('from') ?? '/';
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Login (kiwa Astro PoC)</title>
  </head>
  <body>
    <main>
      <h1>Login (kiwa PoC)</h1>
      <form method="POST">
        <label>
          session value: <input type="text" name="session" value="admin" />
        </label>
        <input type="hidden" name="from" value={from} />
        <button type="submit">login</button>
      </form>
    </main>
  </body>
</html>
