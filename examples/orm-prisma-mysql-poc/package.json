{
  "name": "examples-orm-prisma-mysql-poc",
  "version": "0.0.2",
  "private": true,
  "type": "module",
  "scripts": {
    "prisma:generate": "prisma generate --schema=prisma/schema.prisma",
    "test": "pnpm -F @kiwa-test/orm -F @kiwa-test/core build && pnpm prisma:generate && node -e \"require('node:fs').rmSync('.vitest-dist',{recursive:true,force:true})\" && tsc -p tsconfig.vitest.json && vitest run .vitest-dist/tests --environment node",
    "typecheck": "pnpm prisma:generate && tsc --noEmit"
  },
  "dependencies": {
    "@kiwa-test/core": "workspace:*",
    "@kiwa-test/orm": "workspace:*",
    "@prisma/client": "^5.22.0",
    "@testcontainers/mysql": "^10.16.0",
    "prisma": "^5.22.0",
    "testcontainers": "^10.16.0"
  },
  "devDependencies": {
    "@types/dockerode": "^3.3.0",
    "@types/node": "^22.10.0",
    "dockerode": "^4.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
