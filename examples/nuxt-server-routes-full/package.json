{
  "name": "examples-nuxt-server-routes-full",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node ../../scripts/build-deps.mjs @kiwa-lab/nuxt @kiwa-lab/core",
    "dev": "nuxt dev",
    "test": "pnpm build && node -e \"require('node:fs').rmSync('.vitest-dist',{recursive:true,force:true})\" && tsc -p tsconfig.vitest.json && vitest run .vitest-dist/tests --environment node",
    "test:e2e": "playwright test",
    "typecheck": "nuxt prepare && tsc --noEmit"
  },
  "dependencies": {
    "@kiwa-lab/core": "workspace:*",
    "@kiwa-lab/nuxt": "workspace:*"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.10.0",
    "nuxt": "^3.14.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
