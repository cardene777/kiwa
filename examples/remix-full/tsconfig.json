{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "dist",
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": ["node", "vitest", "@remix-run/node"],
    "noUncheckedIndexedAccess": false
  },
  "include": ["app/**/*.ts", "app/**/*.tsx"],
  "exclude": [
    "node_modules",
    "dist",
    "build",
    ".vitest-dist",
    "tests/**",
    "playwright.config.ts"
  ]
}
