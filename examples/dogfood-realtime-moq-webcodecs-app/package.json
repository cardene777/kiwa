{
  "name": "dogfood-realtime-moq-webcodecs-app",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Dogfood app v1.45-2 — MoQ + WebCodecs encoder + Simulcast/SVC observability harness backed by @kiwa-lab/realtime v0.3 moq-fetch + webcodecs-encoder + simulcast-svc semantics.",
  "scripts": {
    "test": "node ../../scripts/build-deps.mjs @kiwa-lab/core @kiwa-lab/realtime && vitest run tests --exclude '**/.vitest-dist/**' --environment node",
    "typecheck": "tsc --noEmit",
    "test:perf": "vitest run -c vitest.perf.config.ts --reporter=verbose"
  },
  "dependencies": {
    "@kiwa-lab/core": "workspace:*",
    "@kiwa-lab/realtime": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.6.0",
    "vitest": "^3.2.6"
  }
}
