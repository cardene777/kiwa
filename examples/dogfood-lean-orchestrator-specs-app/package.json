{
  "name": "dogfood-lean-orchestrator-specs-app",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Dogfood app v2.14-2 — @kiwa-lab/lean で depth-5 pattern 5 lifecycle-orchestrator (transaction / session / cache / job / cli) の Lean 4 spec を生成、 kiwa の runtime testing (TS + vitest) と 静的形式検証 (Lean 4) を 同じ SSOT で駆動する仕様駆動開発 dogfood。",
  "scripts": {
    "test": "node ../../scripts/build-deps.mjs @kiwa-lab/core @kiwa-lab/lean && vitest run tests --exclude '**/.vitest-dist/**' --environment node",
    "typecheck": "tsc --noEmit",
    "specs:generate": "pnpm -F @kiwa-lab/lean build && tsc -p tsconfig.vitest.json && node .vitest-dist/scripts/generate-lean-project.js",
    "test:perf": "vitest run -c vitest.perf.config.ts --reporter=verbose"
  },
  "dependencies": {
    "@kiwa-lab/auth": "workspace:*",
    "@kiwa-lab/cache": "workspace:*",
    "@kiwa-lab/cli-test": "workspace:*",
    "@kiwa-lab/core": "workspace:*",
    "@kiwa-lab/lean": "workspace:*",
    "@kiwa-lab/orm": "workspace:*",
    "@kiwa-lab/queue": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.6.0",
    "vitest": "^3.2.6"
  }
}
