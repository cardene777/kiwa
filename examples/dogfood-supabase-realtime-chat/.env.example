# Real mode envs — populate to drive @supabase/supabase-js against a live
# Supabase project. When either variable is missing the dogfood adapter emits
# `SUPABASE_ENV_MISSING` traces and the fidelity harness records the gap.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
