## Optional — enable KIWA_MODE=real by setting the OpenAI API key.
## When absent, the real adapter surfaces `OPENAI_ENV_MISSING` on every op
## and the fidelity harness records the gap without failing the suite.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com
KIWA_MODE=mock
