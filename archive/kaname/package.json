{
  "name": "@kiwa-lab/kaname",
  "version": "0.1.1",
  "description": "kiwa spec-driven development toolkit. Classify specification items into three layers (formal-verifiable, runtime-testable, human-review-only) and emit paired spec files: specFormal.md for Lean-verifiable state machines and pure contracts, specRuntime.md for side effects, integration, and UX. Structurally prevents the 'written but never verified' silent gap. Named for the kaname, the pivot that fastens every rib of a folding fan at a single point.",
  "license": "UNLICENSED",
  "author": {
    "name": "cardene",
    "url": "https://github.com/cardene777"
  },
  "keywords": [
    "kiwa",
    "kiwa-lab",
    "kaname",
    "spec-driven-development",
    "specification",
    "formal-verification",
    "runtime-verification",
    "lean",
    "verification-gap-detection"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cardene777/kiwa.git",
    "directory": "archive/kaname"
  },
  "homepage": "https://github.com/cardene777/kiwa#readme",
  "bugs": {
    "url": "https://github.com/cardene777/kiwa/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "test": "node -e \"require('node:fs').rmSync('.vitest-dist',{recursive:true,force:true})\" && tsc -p tsconfig.vitest.json && vitest run .vitest-dist/tests --environment node",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "node ../../scripts/assert-pnpm-publish.mjs"
  },
  "dependencies": {
    "@kiwa-lab/core": "workspace:*",
    "@kiwa-lab/lean": "workspace:*"
  },
  "peerDependencies": {
    "vitest": "^3.2.6"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^3.2.6"
  },
  "private": true
}
