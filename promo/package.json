{
  "name": "kiwa-promo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Promotional videos for kiwa, authored with Remotion",
  "scripts": {
    "studio": "remotion studio --port=3737",
    "render:opening": "remotion render Opening out/opening.mp4",
    "render:problem": "remotion render Problem out/problem.mp4",
    "render:one-spec": "remotion render OneSpec out/one-spec.mp4",
    "render:test-surfaces": "remotion render TestSurfaces out/test-surfaces.mp4",
    "render:polyglot": "remotion render Polyglot out/polyglot.mp4",
    "render:flow": "remotion render Flow out/flow.mp4",
    "render:quality-gates": "remotion render QualityGates out/quality-gates.mp4",
    "render:install": "remotion render Install out/install.mp4",
    "render:outro": "remotion render Outro out/outro.mp4",
    "render:promo": "remotion render KiwaPromo out/kiwa-promo.mp4",
    "render:all": "pnpm render:promo",
    "upgrade": "remotion upgrade",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.475",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.475"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "typescript": "^5.6.0"
  }
}
