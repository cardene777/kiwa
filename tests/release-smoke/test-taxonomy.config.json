{
  "$schema-comment": "Q1 = test taxonomy meta lint config。 SSOT = docs/concepts/test-taxonomy.md § dir 構成。 各 pkg の分類 + 免除 pkg を宣言する。",
  "requirePerf": {
    "description": "全 pkg 必須。 tests/perf/ dir + *.perf.ts が最低 1 件存在すること。",
    "exempt": [
      "perf-harness",
      "skill-test",
      "release-invariants",
      "kaname",
      "kiwa",
      "lean",
      "desktop",
      "mobile",
      "security-devsecops"
    ],
    "exemptReasons": {
      "perf-harness": "本体が perf primitive、 自己 dogfood は不要",
      "skill-test": "本体が skill 発火 assertion primitive、 domain 実装なし = perf 対象外",
      "release-invariants": "release 時点の invariant chk のみ、 runtime perf 対象外",
      "kaname": "meta pkg (kiwa 内部 CLI wrapper)",
      "kiwa": "meta pkg (unified re-export)",
      "lean": "experimental、 未実装 stub",
      "desktop": "platform-specific、 別枠 (将来 tests/perf-desktop/)",
      "mobile": "platform-specific、 別枠 (将来 tests/perf-mobile/)",
      "security-devsecops": "policy pkg、 runtime code 少ない"
    }
  },
  "requireFidelity": {
    "description": "全 lib 必須 (user 要求で 9 lib exemplar → 全 lib 拡充、 CAR-fidelity-integration-all-libs)。 tests/fidelity/ dir + *.fidelity.test.ts が最低 1 件存在すること。",
