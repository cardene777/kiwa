dist/
# VitePress のビルド一時産物。実行時の作業ディレクトリによって docs/ 配下にも
# repo root にも出るため、階層を固定しない。
**/.vitepress/.temp/
**/.vitepress/cache/
.vitest-dist/
playwright-report/
test-results/
.context/local-review/
.context/delegate/
.claude/.context/
.claude/.scratch/
.claude/settings.local.json
.claude/.gitignore.local
.mcp.json
*.log
coverage/
# perf baseline は repo root の 1 箇所に集約して追跡する (#1708)。
# 追跡しないと「誰が測っても初回は比較対象が無い」 状態が続き、
# 回帰判定は最初の 1 回を必ず取りこぼす。
# 起動場所ごとに分かれていた過去の置き場は読まれないので追跡しない。
packages/*/.perf-baseline/
examples/*/.perf-baseline/
# baseline は記録した機械でしか比較に使えないため、環境ごとの dir に分ける (#1729)。
# 全環境を追跡すると 148 file が機械の数だけ増えるので、1 つだけを追跡する。
# ここを変える時は `packages/perf-harness/src/baseline.ts` の
# `CANONICAL_ENV_PROFILE` と `docs/quality/perf-thresholds.md` も同時に直す。
.perf-baseline/*
!.perf-baseline/darwin-arm64--apple-m4-pro-43c7d7--node24/
# v1.30-1 kept `.a11y-baseline/` ignored while stubs were in flight; v1.30-2
# lands real 3-layer baselines so per-package `.a11y-baseline/<pkg>.json`
# files are tracked from here on (folder stays writable).
.stryker-tmp/
mutation-report/
.DS_Store
examples/*/cache/
examples/*/forge-out/build-info/
examples/*/.next/
examples/*/.env.local
examples/*/.env
examples/*/dist/
examples/*/tsconfig.tsbuildinfo
examples/*/.context/
# Detection output and anvil state. Both are derived from the project and are
# rewritten on demand, so committing them would only make them go stale.
.kiwa/

examples/*/lcov.info
# Every dogfood example's `pnpm test` rewrites `quality-report/fidelity-latest.{json,md}`.
# `reportedAt` changes on every run, and ten of them also carry wall-clock latency
# (`p50Ms` / `p95Ms` / `p99Ms`) that lands on a different float each time. 27 examples
# ignored the path in their own `.gitignore`; 34 committed it, so a full test run left 56
# modified files behind and a `git add -A` swept them into whatever was being committed.
# The reviewed snapshot a release depends on is promoted by hand to
# `docs/quality-reports/<domain>/<name>.md`, which stays tracked. Nothing reads the
# per-example copy.
examples/*/quality-report/

# Local-only context (markers / spec drafts / scratch)
.context/

# JetBrains IDE (IntelliJ IDEA / WebStorm / PyCharm 等)
.idea/
*.iml

# VSCode (project-level settings は per-team で commit する場合もあるが、
# default では除外し、 必要な settings は別途明示 commit する方針)
.vscode/
*.code-workspace

# Windows OS metadata
Thumbs.db
Desktop.ini

# Vim / Emacs / 一般エディタの swap / temp
*.swp
*.swo
*~

# Backup / temp files
*.bak
*.tmp
.tmp/

# tsup が config を bundle する際に生成する一時 file。 実行ごとに別名 (ランダム
# suffix) で残り、 中身は tsup.config.ts の transpile 結果でしかない。
tsup.config.bundled_*.mjs

# Stryker mutation report
mutation-report/
.stryker-tmp/

kiwa-py/.venv/

# kiwa-py Python build artifacts
kiwa-py/.venv/
kiwa-py/**/__pycache__/
kiwa-py/**/*.pyc
kiwa-py/build/
kiwa-py/dist/
kiwa-py/*.egg-info/

# python-todo-poc artifacts
examples/python-todo-poc/.venv/
examples/python-todo-poc/**/__pycache__/
examples/python-todo-poc/**/*.pyc
examples/python-todo-poc/**/*.egg-info/
examples/python-todo-poc/build/
examples/python-todo-poc/dist/

# Rust の残骸。 #1864 で Rust 対応を削除したため新規には生成されないが、 削除前の build で
# 作られた `target/` と `Cargo.lock` が手元に残る場合がある。 追跡下に入れない。
target/
Cargo.lock

# Lake build artifacts. `.lake/` is never anything but output.
# `lake-manifest.json` pins a project's dependencies and belongs in a repository
# that has any; the dogfood specs have none, and `lake build` rewrites it with
# whatever version of Lake ran. Ignore it there, and nowhere else.
.lake/
examples/dogfood-lean-orchestrator-specs-app/specs/lake-manifest.json
